# Copy to .env with `make env` (fills every "change-me" with a random secret).

# --- Host ports (chosen to avoid clashing with other local stacks) ---
POSTGRES_PORT=5433
AIRFLOW_PORT=8081
METABASE_PORT=3001
COLLECTOR_PORT=8010
WEB_PORT=8030

# --- PostgreSQL: superuser (init only) and least-privilege service roles ---
POSTGRES_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
METABASE_DB_PASSWORD=change-me
PMS_ADMIN_PASSWORD=change-me
PMS_READER_PASSWORD=change-me
DWH_ETL_PASSWORD=change-me
BI_READER_PASSWORD=change-me

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me

# --- Metabase admin account (created automatically on first start) ---
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=change-me

# --- Source-system simulation ---
# Date the dataset's "today" is aligned to. Empty = day of first bootstrap.
SIM_ANCHOR_DATE=
PII_HASH_SALT=change-me

# --- LLM for chart explanations (milestone M5) ---
ANTHROPIC_API_KEY=
