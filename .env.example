# Copy to .env with `make env` (fills every "change-me" with a random secret).

# --- Host ports (chosen to avoid clashing with other local stacks) ---
POSTGRES_PORT=5433
AIRFLOW_PORT=8081
METABASE_PORT=3001
COLLECTOR_PORT=8010
WEB_PORT=8030
INSIGHT_PORT=8020

# --- PostgreSQL: superuser (init only) and least-privilege service roles ---
POSTGRES_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
METABASE_DB_PASSWORD=change-me
PMS_ADMIN_PASSWORD=change-me
PMS_READER_PASSWORD=change-me
DWH_ETL_PASSWORD=change-me
BI_READER_PASSWORD=change-me
INSIGHT_DB_PASSWORD=change-me

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me

# --- Metabase admin account (created automatically on first start) ---
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=change-me
# non-admin account the insight service queries Metabase with
MB_INSIGHT_PASSWORD=change-me

# --- Source-system simulation ---
# Date the dataset's "today" is aligned to. Empty = day of first bootstrap.
SIM_ANCHOR_DATE=
PII_HASH_SALT=change-me

# --- "Explain this chart": any OpenAI-compatible endpoint ---
# Without a key, explanations are generated from the computed facts only (no AI).
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
# optional: reasoning effort for reasoning models (e.g. none, low) and the session header
# OpenCode Go requires (x-opencode-session)
LLM_REASONING_EFFORT=
LLM_SESSION_HEADER=

# --- Alerts: optional Slack-compatible incoming webhook (alerts are always in audit.alerts) ---
ALERT_WEBHOOK_URL=
